// Shared, tracked build settings. Machine-specific values (team id, bundle prefix) live in
// Local.xcconfig (untracked; see Local.xcconfig.example) and override the defaults below.

IPHONEOS_DEPLOYMENT_TARGET = 18.0
WATCHOS_DEPLOYMENT_TARGET = 11.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
CODE_SIGN_STYLE = Automatic

// API base URL of the deployed Worker. `$()` keeps `//` from reading as a comment.
WW_API_BASE = https:/$()/wind-watch.wind-watch-server.workers.dev

// Defaults; Local.xcconfig overrides them on a real build machine.
WW_BUNDLE_PREFIX = com.example
WW_TEAM_ID =

#include? "Local.xcconfig"
