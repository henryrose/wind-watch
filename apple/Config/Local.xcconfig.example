// Copy to Local.xcconfig (untracked) on each build machine.
// Shared.xcconfig includes Local.xcconfig if it exists.

// Apple Developer team id (10 characters). Leave empty for simulator-only builds.
WW_TEAM_ID =

// Reverse-DNS prefix for bundle ids and the app group:
//   $(WW_BUNDLE_PREFIX).windwatch
//   $(WW_BUNDLE_PREFIX).windwatch.watchkitapp
//   $(WW_BUNDLE_PREFIX).windwatch.watchkitapp.complications
//   group.$(WW_BUNDLE_PREFIX).windwatch
WW_BUNDLE_PREFIX = com.example
